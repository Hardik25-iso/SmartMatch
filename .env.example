# Copy this file to .env and fill in real values.  Do NOT commit .env.
# docker compose reads these automatically for ${VAR} substitution.

SECRET_KEY=change-this-to-a-long-random-string
DB_USER=root
DB_PASSWORD=change-this-strong-password
DB_HOST=db
DB_NAME=orphanage_db

# --- SmartMatch ---
# Clients of /api/recommend and /api/stale-listings send this as the X-API-Key header.
# If unset, the API only works for a logged-in admin.
SMARTMATCH_API_KEY=change-this-api-key
# Public URL of the app, used in alert messages.
APP_BASE_URL=http://localhost
# Alerts are only logged (not delivered) until this is false AND a channel below is configured.
ALERTS_DRY_RUN=true
ALERT_COOLDOWN_DAYS=7
# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
# WhatsApp (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Demo/synthetic NGOs are never messaged for real. To demo live delivery, send every alert to yourself:
ALERTS_REDIRECT_EMAIL=
ALERTS_REDIRECT_WHATSAPP=

# Only needed if you later deploy the RabbitMQ worker (worker.py):
# MQ_URL=amqp://guest:guest@rabbitmq:5672/
